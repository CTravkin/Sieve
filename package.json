{
  "name": "sieve",
  "version": "0.6.7",
  "sieveBuild": 20,
  "private": true,
  "description": "Excludes files and folders before vault indexing",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/check-project.mjs",
    "test": "node --test Tests/*.test.mjs",
    "build:core": "node scripts/build-core.mjs",
    "typecheck": "tsc --noEmit",
    "test:core": "npm run build:core && node --test Tests/Core/*.test.mjs",
    "test:oracle": "npm run build:core && node --test Tests/Oracle/*.test.mjs",
    "build": "node scripts/build-plugin.mjs",
    "test:adapters": "node --test Tests/Adapters/*.test.mjs",
    "test:settings": "node --test Tests/Settings/*.test.mjs",
    "test:ui": "node --test Tests/SettingsUI/*.test.mjs Tests/I18n/*.test.mjs",
    "test:alias": "node --test Tests/Alias/*.test.mjs",
    "test:package": "node --test Tests/Packaging/*.test.mjs",
    "test:regression": "node --test Tests/*.test.mjs Tests/Adapters/*.test.mjs Tests/Settings/*.test.mjs Tests/SettingsUI/*.test.mjs Tests/I18n/*.test.mjs Tests/Alias/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "typescript": "7.0.2"
  }
}
