{
  "name": "sieve",
  "version": "1.0.4",
  "sieveBuild": 39,
  "private": true,
  "description": "Excludes files and folders before vault indexing.",
  "type": "module",
  "license": "MPL-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "check": "node scripts/check-project.mjs",
    "lint": "cd .. && eslint --config Plugin/eslint.config.mjs Plugin/src --max-warnings 2",
    "test": "node scripts/run-tests.mjs Tests/*.test.mjs",
    "build:core": "node scripts/build-core.mjs",
    "typecheck": "tsc --noEmit",
    "test:core": "npm run build:core && node scripts/run-tests.mjs Tests/Core/*.test.mjs",
    "test:oracle": "npm run build:core && node scripts/run-tests.mjs --oracle Tests/Oracle/*.test.mjs",
    "build": "node scripts/build-plugin.mjs",
    "test:adapters": "node scripts/run-tests.mjs Tests/Adapters/*.test.mjs",
    "test:settings": "node scripts/run-tests.mjs Tests/Settings/*.test.mjs",
    "test:ui": "node scripts/run-tests.mjs Tests/SettingsUI/*.test.mjs Tests/I18n/*.test.mjs",
    "test:alias": "node scripts/run-tests.mjs Tests/Alias/*.test.mjs",
    "test:package": "node scripts/run-tests.mjs Tests/Packaging/*.test.mjs",
    "test:regression": "node scripts/run-tests.mjs Tests/*.test.mjs Tests/Adapters/*.test.mjs Tests/Settings/*.test.mjs Tests/SettingsUI/*.test.mjs Tests/I18n/*.test.mjs Tests/Alias/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "obsidian": "1.14.4",
    "typescript": "7.0.2"
  },
  "overrides": {
    "ts-api-utils": {
      "typescript": "5.9.3"
    },
    "eslint-plugin-obsidianmd": {
      "obsidian": "$obsidian",
      "typescript": "5.9.3"
    }
  }
}
