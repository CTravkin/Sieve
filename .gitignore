.sass-cache/
.vercel/
.netlify/
.eslintcache
.stylelintcache
*.tsbuildinfo
vite.config.*.timestamp*
vitest.config.*.timestamp*

# Python environments, bytecode and tool caches
__pycache__/
*.pyc
*.pyo
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.hypothesis/
.tox/
.nox/
