venv/
__pypackages__/
.ipynb_checkpoints/
.coverage
.coverage.*

# Native tool caches
.cache/
.gradle/
.kotlin/
.dart_tool/
.terraform/

# Logs and root-level generated temporary output
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
/logs/
/tmp/
/temp/
/coverage/
/htmlcov/

# OS/editor temporary files
.DS_Store
._*
[Dd]esktop.ini
[Tt]humbs.db
ehthumbs.db
*~
*.bak
*.temp
*.tmp

# Project-specific generated output and exceptions
# Add actual build, upload, database, exported-config and secret paths here.
# Generic build/, dist/, bin/, out/, target/, vendor/ and Tools/ are
# intentionally not excluded: these names may contain project source.
# Native project files and dependency lockfiles remain eligible for tracking.
# Example adaptations, enable only when they match the project policy:
# /path/to/application/dist/
# /path/to/application/build/
# /path/to/application/bin/
# /path/to/application/obj/
# /path/to/application/target/
# /path/to/application/uploads/
# !/path/to/application/.env.dev
# !/path/to/application/.env.test
# !/path/to/application/.env.prod

# Sieve application policy: shipped docs and application instructions are shared.
!/Docs/
!/Docs/**
!/AGENTS.md
/dist/
/.obsidian/
